# Copy this file to .env and fill in your own values. Never commit .env.

# Groq API keys (use as many as you have, 1 to 5; keys from one account usually share a quota)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# OpenRouter API keys (last-resort fallback)
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=

# Models in LiteLLM format. Provider catalogs change, so check the current model IDs.
GROQ_MODEL=groq/openai/gpt-oss-120b
GROQ_MODEL_2=groq/openai/gpt-oss-20b
OPENROUTER_MODEL=openrouter/<a-free-model-id>:free

# Hugging Face
HF_USERNAME=
HF_TOKEN=            # read-only token; the account must have accepted the GAIA dataset terms

# Contact address used in the HTTP User-Agent (Wikimedia policy)
EMAIL=

# Whisper model size: tiny, base, small, medium (default: small)
WHISPER_MODEL=small
